PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# =============================================================================
# SMTP Email Configuration for OTP Verification
# =============================================================================
# For Gmail SMTP:
# 1. SMTP_HOST=smtp.gmail.com
# 2. SMTP_PORT=587 (STARTTLS) or 465 (SSL)
# 3. SMTP_USER=your_sending_gmail_address@gmail.com
# 4. SMTP_PASS=your_google_app_password
#    NOTE: This MUST be a 16-character Google App Password (not your personal Gmail password).
#    Generate it at: Google Account -> Security -> 2-Step Verification -> App Passwords.
#    A Google OAuth Client ID is NOT an SMTP password.
# 5. EMAIL_FROM="DevOps Learning Platform" <your_sending_gmail_address@gmail.com>
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
